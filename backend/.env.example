# Copie este arquivo para .env e ajuste os valores.
# (o arquivo .env NAO vai pro GitHub - veja o .gitignore)

# Porta onde a API vai rodar
PORT=3000

# Chave secreta usada para assinar os tokens JWT.
# TROQUEM por um texto aleatorio e longo de verdade.
JWT_SECRET=troque_esta_chave_por_algo_bem_secreto_e_aleatorio

# Por quanto tempo o token fica valido
JWT_EXPIRES_IN=1d
